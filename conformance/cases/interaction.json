[
  {
    "id": "i-uncovered-button",
    "title": "按钮的 click 没有处理器是警告：点了没反应必须被说出来",
    "spec": "04-vocabulary.md 第 5.1 节；06-diagnostics.md 第 4.8 节",
    "program": [
      "add #root window #win",
      "add #win button #b text=\"x\""
    ],
    "loadExpect": {
      "diagnostics": [
        {
          "code": "UNCOVERED_INTERACTION",
          "level": "warning"
        }
      ]
    },
    "steps": [
      {
        "expect": {
          "nodes": [
            "#b"
          ]
        }
      }
    ]
  },
  {
    "id": "i-covered-button",
    "title": "按钮的 click 有处理器即无此警告",
    "spec": "04-vocabulary.md 第 5.1 节",
    "program": [
      "add #root window #win",
      "add #win button #b text=\"x\"",
      "on #b click: set #b text=\"hit\""
    ],
    "loadExpect": {
      "noDiagnostics": true
    },
    "steps": [
      {
        "fire": {
          "target": "#b",
          "event": "click"
        },
        "expect": {
          "attrs": {
            "#b.text": "hit"
          }
        }
      }
    ]
  },
