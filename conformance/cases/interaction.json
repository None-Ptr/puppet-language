  {
    "id": "i-template-checkbox-uncovered",
    "title": "模板行内的勾选框没有 change 处理器同样是警告",
    "spec": "04-vocabulary.md 第 5.1 节",
    "program": [
      "add #root window #win",
      "add #win list #items source=#todos template=#tpl",
      "add #root template #tpl as t",
      "add #tpl checkbox #done value=t.done",
      "data #todos = [] of {done: bool = false}"
    ],
    "loadExpect": {
      "diagnostics": [
        {
          "code": "UNCOVERED_INTERACTION",
          "level": "warning"
        }
      ]
    },
    "steps": [
      {
        "expect": {
          "nodes": [
            "#done"
          ]
        }
      }
    ]
  },
  {
    "id": "i-checkbox-toggle-writes-back",
    "title": "勾选框的 change 处理器把状态写回数据源，绑定随之更新",
    "spec": "03-semantics.md 第 2.7 节；04-vocabulary.md 第 5.1 节",
    "program": [
      "add #root window #win",
      "add #win list #items source=#todos template=#tpl",
      "add #win text #n text=str(count(#todos))",
      "add #root template #tpl as t",
      "add #tpl checkbox #done value=t.done",
      "add #tpl text #label text=t.text",
      "data #todos = [] of {text: str = \"\", done: bool = false}",
      "on #done change as e: update_where #todos as r set done=e.value where r.text == t.text"
    ],
    "loadExpect": {
      "noDiagnostics": true
    },
    "steps": [
      {
        "send": [
          "append #todos item={text: \"a\", done: false}"
        ],
        "expect": {
          "data": {
            "#todos": [
              {
                "text": "a",
                "done": false
              }
            ]
          }
        }
      },
      {
        "fire": {
          "target": "#done",
          "event": "change",
          "row": 0,
          "value": true
        },
        "expect": {
          "data": {
            "#todos": [
              {
                "text": "a",
                "done": true
              }
            ]
          }
        }
      },
      {
        "fire": {
          "target": "#done",
          "event": "change",
          "row": 0,
          "value": false
        },
        "expect": {
          "data": {
            "#todos": [
              {
                "text": "a",
                "done": false
              }
            ]
          }
        }
      }
    ]
  },
  {
    "id": "i-change-payload-value",
    "title": "change 事件的载荷携带新值，处理器据此回写（不必靠取反猜测）",
    "spec": "03-semantics.md 第 2.8 节；01-grammar.md 第 7.7 节",
    "program": [
      "add #root window #win",
      "add #win list #items source=#todos template=#tpl",
      "add #root template #tpl as t",
      "add #tpl checkbox #done value=t.done",
      "add #tpl text #label text=t.text",
      "data #todos = [] of {text: str = \"\", done: bool = false}",
      "on #done change as e: update_where #todos as r set done=e.value where r.text == t.text"
    ],
    "loadExpect": {
      "noDiagnostics": true
    },
    "steps": [
      {
        "send": [
          "append #todos item={text: \"a\", done: false}"
        ],
        "expect": {
          "data": {
            "#todos": [
              {
                "text": "a",
                "done": false
              }
            ]
          }
        }
      },
      {
        "fire": {
          "target": "#done",
          "event": "change",
          "row": 0,
          "value": true
        },
        "expect": {
          "data": {
            "#todos": [
              {
                "text": "a",
                "done": true
              }
            ]
          }
        }
      },
      {
        "fire": {
          "target": "#done",
          "event": "change",
          "row": 0,
          "value": true
        },
        "expect": {
          "data": {
            "#todos": [
              {
                "text": "a",
                "done": true
              }
            ]
          }
        }
      }
    ]
  },
  {
    "id": "i-bound-value-not-written",
    "title": "值绑定了数据源却没回写：警告（用户的改动会被覆盖）",
    "spec": "03-semantics.md 第 2.8 节；06-diagnostics.md 第 4.8 节",
    "program": [
      "add #root window #win",
      "add #win list #items source=#todos template=#tpl",
      "add #win text #echo text=\"\"",
      "add #root template #tpl as t",
      "add #tpl checkbox #done value=t.done",
      "data #todos = [] of {text: str = \"\", done: bool = false}",
      "on #done change as e: set #echo text=str(e.value)"
    ],
    "loadExpect": {
      "diagnostics": [
        {
          "code": "BOUND_VALUE_NOT_WRITTEN",
          "level": "warning"
        }
      ]
    },
    "steps": [
      {
        "expect": {
          "nodes": [
            "#done"
          ]
        }
      }
    ]
  },
  {
    "id": "i-change-payload-observed",
    "title": "订阅的 change 事件载荷也带新值",
    "spec": "03-semantics.md 第 6 节",
    "program": [
      "add #root window #win",
      "add #win input #q placeholder=\"搜索\"",
      "add #win text #n text=\"\"",
      "listen #q change",
      "on #q change as e: set #n text=e.value"
    ],
    "loadExpect": {
      "noDiagnostics": true
    },
    "steps": [
      {
        "fire": {
          "target": "#q",
          "event": "change",
          "value": "abc"
        },
        "expect": {
          "events": [
            {
              "target": "#q",
              "event": "change",
              "value": "abc"
            }
          ],
          "attrs": {
            "#n.text": "abc"
          }
        }
      }
    ]
  },
  {
    "id": "ir-click-via-renderer",
    "title": "点击经渲染器投递为 click 事件并触发处理器（可观察触发条件）",
    "spec": "05-render-contract.md 第 4 节",
    "requires": [
      "interaction"
    ],
    "program": [
      "add #root window #win",
      "add #win text #t text=\"\"",
      "add #win button #b text=\"点我\"",
      "on #b click: set #t text=\"clicked\""
    ],
    "loadExpect": {
      "noDiagnostics": true
    },
    "steps": [
      {
        "interact": {
          "target": "#b",
          "action": "click"
        },
        "expect": {
          "attrs": {
            "#t.text": "clicked"
          }
        }
      }
    ]
  },
  {
    "id": "ir-change-writeback-via-renderer",
    "title": "勾选经渲染器投递为 change，受控处理器回写数据源",
    "spec": "05-render-contract.md 第 4 节；03-semantics.md 第 2.8 节",
    "requires": [
      "interaction"
    ],
    "program": [
      "add #root window #win",
      "data #n = [{v: false}] of {v: bool = false}",
      "add #win checkbox #c value=#n.v",
      "on #c change as e: update_where #n as r set v=e.value where r.v == false"
    ],
    "loadExpect": {
      "noDiagnostics": true
    },
    "steps": [
      {
        "interact": {
          "target": "#c",
          "action": "change",
          "value": true
        },
        "expect": {
          "data": {
            "#n": [
              {
                "v": true
              }
            ]
          }
        }
      }
    ]
  },
  {
    "id": "ir-no-renderer-degrades",
    "title": "没有渲染层时用户动作必须可见降级（禁止假装送达）",
    "spec": "05-render-contract.md 第 4 节；06-diagnostics.md 第 4.7 节",
    "program": [
      "add #root window #win",
      "add #win button #b text=\"x\"",
      "on #b click: set #b text=\"hit\""
    ],
    "steps": [
      {
        "interact": {
          "target": "#b",
          "action": "click"
        },
        "expect": {
          "degraded": [
            "interaction"
          ]
        }
      }
    ]
  },
  {
    "id": "i-input-submit-payload",
    "title": "input 的 submit 载荷携带新值（移动键盘完成键的语义）",
    "spec": "01-grammar.md 第 7.7 节；04-vocabulary.md 第 5.1 节",
    "program": [
      "add #root window #win",
      "add #win col #content pad=16",
      "data #todos = [] of {text: str}",
      "add #content input #inp placeholder=\"新待办\"",
      "on #inp submit as e:",
      "    append #todos item={text: e.value} ; set #inp value=\"\""
    ],
    "loadExpect": {
      "noDiagnostics": true
    },
    "steps": [
      {
        "interact": {
          "target": "#inp",
          "action": "submit",
          "value": "买酱油"
        },
        "expect": {
          "data": {
            "#todos": [
              {
                "text": "买酱油"
              }
            ]
          }
        }
      },
      {
        "send": [
          "where #inp"
        ],
        "expect": {
          "diagnostics": []
        }
      }
    ],
    "requires": [
      "interaction"
    ]
  },
  {
    "id": "i-fire-target-missing",
    "title": "fire 打到不存在的目标是错误（静默无效必须被说出来）",
    "spec": "06-diagnostics.md 第 3 节与第 4.1 节",
    "program": [
      "add #root window #win",
      "add #win button #b text=\"走\"",
      "add #win text #t text=\"未发生\"",
      "on #b click: set #t text=\"hit\""
    ],
    "loadExpect": { "noDiagnostics": true },
    "steps": [
      {
        "fire": { "target": "#ghost", "event": "click" },
        "expect": {
          "diagnostics": [{ "code": "TARGET_MISSING", "level": "error" }],
          "attrs": { "#t.text": "未发生" },
          "note": "没有任何效果：诊断必须说出来，而不是让驱动者以为成功了"
        }
      }
    ]
  },
